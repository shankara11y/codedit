# Server Configuration
PORT=5050
NODE_ENV=development

# Allowed CORS origins for production (comma-separated or * for all)
# Example for Vercel frontend: CORS_ORIGIN=https://codefix-ai.vercel.app,http://localhost:5174
CORS_ORIGIN=*

# Google Gemini API Key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model (defaults to gemini-3.8-flash, with automatic fallback to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.8-flash

# Execution Engine Configuration: 'judge0' (default, cloud/serverless ready) or 'docker' (local fallback)
EXECUTION_BACKEND=judge0

# Judge0 API Configuration
# Defaults to the free, public Judge0 CE official endpoint (https://ce.judge0.com)
JUDGE0_API_URL=https://ce.judge0.com
# Optional: RapidAPI or self-hosted API credentials (leave empty when using ce.judge0.com)
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Supabase Persistent Storage Configuration (https://supabase.com/dashboard)
# Required for persisting debugging sessions, repaired code, and test evaluation results
SUPABASE_URL=https://your-project-id.supabase.co
# Can be your public anon key or secret service_role key (kept safe on the backend)
SUPABASE_ANON_KEY=your_supabase_anon_or_service_key

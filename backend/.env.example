# Server Configuration
PORT=5050
NODE_ENV=development

# Allowed CORS origins for production (comma-separated or * for all)
# Example for Vercel frontend: CORS_ORIGIN=https://codefix-ai.vercel.app,http://localhost:5174
CORS_ORIGIN=*

# Google Gemini API Key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model (defaults to gemini-3.8-flash, with automatic fallback to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.8-flash
